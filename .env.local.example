# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Replace with your GA4 Measurement ID (format: G-XXXXXXXXXX).
# Leave blank to disable analytics (it is automatically disabled in development).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── SMTP — Hostinger (or any provider) ───────────────────────────────────────
# Use port 465 for SSL (secure: true) or 587 for STARTTLS
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@elevora.dev
SMTP_PASS=YOUR_PASSWORD

# ── Contact form recipient ────────────────────────────────────────────────────
CONTACT_RECEIVER_EMAIL=hello@elevora.dev
